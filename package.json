{
  "name": "icimg",
  "version": "1.2.0",
  "description": "A lightweight, dependency-free image editor with an Apple-inspired interface.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      },
      "default": "./dist/engine.js"
    },
    "./umd": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/icimg.umd.cjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/icimg.umd.cjs"
      },
      "default": "./dist/icimg.umd.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "README.en.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "./dist/icimg.amd.js",
    "./dist/icimg.global.js",
    "./dist/icimg.umd.js",
    "./dist/icimg.umd.cjs"
  ],
  "scripts": {
    "dev": "vite demo --host 0.0.0.0",
    "build": "tsup src/index.ts src/engine.ts --format esm,cjs --dts --minify --clean --no-splitting && node scripts/build-browser.mjs",
    "build:demo": "vite build demo --outDir ../build --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test:modules": "node --test tests/modules.test.mjs",
    "test:all": "npm run typecheck && npm run build && npm run test:modules && npm test"
  },
  "keywords": [
    "image",
    "editor",
    "crop",
    "canvas",
    "web-component",
    "react",
    "vue",
    "i18n",
    "internationalization",
    "shapes",
    "polygon"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "esbuild": "^0.27.7",
    "requirejs": "^2.3.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dubin88/icimg.git"
  },
  "homepage": "https://icimg-studio.robinduvip.chatgpt.site",
  "bugs": {
    "url": "https://github.com/dubin88/icimg/issues"
  },
  "unpkg": "./dist/icimg.global.js",
  "jsdelivr": "./dist/icimg.global.js"
}
